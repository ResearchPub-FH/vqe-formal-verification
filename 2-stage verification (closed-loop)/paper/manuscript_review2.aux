\@writefile{lot}{\contentsline {table}{\numberline {VI}{\ignorespaces Resources conditional on bounded success in the two-stage evaluation, based on 366\xspace  successful executions. Intervals are the original 95\% percentile-bootstrap intervals from 5,000\xspace  resamples. P2 is statistically compatible after Holm adjustment. P3 scales P2 by 9,216\xspace  shots/iteration and is therefore a derived result.}}{9}{table.6}\protected@file@percent }
\newlabel{tab:conditional}{{VI}{9}{Resources conditional on bounded success in the two-stage evaluation, based on \SuccessRuns successful executions. Intervals are the original 95\% percentile-bootstrap intervals from \BootstrapSamples resamples. P2 is statistically compatible after Holm adjustment. P3 scales P2 by \ShotsPerUpdate shots/iteration and is therefore a derived result}{table.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Fault verdict matrix for 5\xspace  scenarios, each repeated 10\xspace  times with different count streams. Every repetition within a row has the displayed vector. Colors and letters indicate A: AGREEMENT, D: DISAGREEMENT, M: ASSUMPTION\_MISMATCH, and I: INCONCLUSIVE. ``Expected verdict'' counts the specified target-obligation result, including an inconclusive result for missing counts. ``DejaVu pass'' counts acceptance by the independent temporal replay. Missing counts are removed from a saved trace. Its L1 D reflects the checker's treatment of incomplete records and does not establish a physical ordering violation.}}{9}{figure.5}\protected@file@percent }
\newlabel{fig:fault-discrepancies}{{5}{9}{Fault verdict matrix for \FaultClasses scenarios, each repeated \FaultRepetitions times with different count streams. Every repetition within a row has the displayed vector. Colors and letters indicate A: AGREEMENT, D: DISAGREEMENT, M: ASSUMPTION\_MISMATCH, and I: INCONCLUSIVE. ``Expected verdict'' counts the specified target-obligation result, including an inconclusive result for missing counts. ``DejaVu pass'' counts acceptance by the independent temporal replay. Missing counts are removed from a saved trace. Its L1 D reflects the checker's treatment of incomplete records and does not establish a physical ordering violation}{figure.5}{}}
