-- invariant (state = BIND -> terms_done = 0)  is true
-- invariant (state = EXECUTE_MEASURE -> circ_ready)  is true
-- invariant theta_version = iter  is true
-- invariant (state = ABORT -> (term_reason != NO_TERM & term_reason != DONE_CONVERGED))  is true
-- invariant bound_version <= theta_version  is true
-- invariant (state = DONE -> (term_reason = DONE_CONVERGED & energy_ready))  is true
-- invariant energy_version <= bound_version  is true
-- specification  G (state = COMPUTE_ENERGY -> all_terms_done)  is true
-- specification  G (state = DONE ->  X state = DONE)  is true
-- specification  G (state = ABORT ->  X state = ABORT)  is true
-- specification  G ( X iter >= iter)  is true
-- specification  G (state = DONE ->  G !(state = ABORT))  is true
-- specification  G (state = ABORT ->  G !(state = DONE))  is true
-- specification  G (state = EXECUTE_MEASURE -> params_ready)  is true
-- specification  G (state = CHECK_STOP -> energy_ready)  is true
-- specification  G (state = OPTIMIZER_STEP -> energy_ready)  is true
-- specification  G ((state = BIND & iter > 0) -> !energy_ready)  is true
-- specification  G ((state = BIND & bind_err) ->  X (state = ABORT & term_reason = ABORT_BIND_ERR))  is true
-- specification  G ((state = EXECUTE_MEASURE & qpu_err) ->  X (state = ABORT & term_reason = ABORT_QPU_ERR))  is true
-- specification  G ((state = COMPUTE_ENERGY & energy_err) ->  X (state = ABORT & term_reason = ABORT_ENERGY_ERR))  is true
-- specification  G ((state = OPTIMIZER_STEP & opt_err) ->  X (state = ABORT & term_reason = ABORT_OPT_ERR))  is true
-- specification  G (((state = CHECK_STOP & !converged) & iter = MAX_ITERS) ->  X (state = ABORT & term_reason = ABORT_MAX_ITERS))  is true
-- specification  G (state = EXECUTE_MEASURE -> bound_version = theta_version)  is true
-- specification  G ((state = OPTIMIZER_STEP & !opt_err) ->  X (params_ready & !energy_ready))  is true
-- specification  G (state = CHECK_STOP -> energy_version = bound_version)  is true
-- specification AF (state = DONE | state = ABORT)  is true
-- specification EF (state = DONE & term_reason = DONE_CONVERGED)  is true
-- specification EF (state = ABORT & term_reason = ABORT_BIND_ERR)  is true
-- specification EF (state = ABORT & term_reason = ABORT_QPU_ERR)  is true
-- specification EF (state = ABORT & term_reason = ABORT_ENERGY_ERR)  is true
-- specification EF (state = ABORT & term_reason = ABORT_OPT_ERR)  is true
