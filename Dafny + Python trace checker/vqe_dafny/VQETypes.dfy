module VQETypes {
  datatype IterationRecord = IterationRecord(
    iteration: nat,
    theta: seq<real>,
    parameterLower: real,
    parameterUpper: real,
    thetaId: string,
    boundThetaId: string,
    energyThetaId: string,
    optimizerThetaId: string,
    energyId: string,
    optimizerEnergyId: string,
    ansatzLayoutId: string,
    hamiltonianLayoutId: string,
    termIds: seq<nat>,
    coefficients: seq<real>,
    expectations: seq<real>,
    perTermEnergies: seq<real>,
    termsDone: seq<bool>,
    shots: seq<nat>,
    countsOnes: seq<nat>,
    countsAvailable: seq<bool>,
    reportedEnergy: real,
    expectedTermCount: nat,
    totalShotsThisIteration: nat,
    parameterCount: nat,
    previousEnergy: real,
    previousEnergyAvailable: bool,
    energyDelta: real,
    convergenceTolerance: real,
    converged: bool,
    finalIteration: bool,
    maxIterations: nat,
    energyReady: bool,
    paramsReady: bool,
    shotBudget: nat,
    budgetUsed: nat
  )
}
